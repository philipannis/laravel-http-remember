# Keep this package's formatting independent of parent directories.
root = true

# Use Laravel's four-space indentation and consistent UTF-8 text files.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Preserve intentional Markdown line breaks that use trailing spaces.
[*.md]
trim_trailing_whitespace = false
