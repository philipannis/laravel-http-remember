# Keep text files consistent across operating systems.
* text=auto eol=lf

# Ship runtime code and documentation without development configuration.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/pint.json export-ignore
/.idea export-ignore
/.vscode export-ignore
/.php-cs-fixer.cache export-ignore
/.pint.cache export-ignore
.DS_Store export-ignore

# Leave dependency installation and version locking to the consuming application.
/composer.lock export-ignore
/vendor export-ignore
